{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bsi-kcp-tambun-bekasi.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://bsi-kcp-tambun-bekasi.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/maintenance.html"
    }
  ]
}